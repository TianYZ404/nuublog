---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import friendsData from "../config/friends.json";
import Giscus from "../components/misc/Giscus.astro";

// 从JSON文件加载友链数据
const friends = friendsData;

// Content(spec/friends.md)
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const linksPost = await getEntry("spec", "friends");

if (!linksPost) {
	throw new Error("Friends page content not found");
}

const { Content } = await render(linksPost);
---

<MainGridLayout title="友链" description="友链">
    {/* 顶部介绍区域：渲染 Markdown 内容 */}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32 mb-4">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>

    {/* 中部：友链卡片网格 */}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 my-4">
                {friends.map((friend) => (
                    <div class="flex flex-nowrap items-stretch h-28 gap-4 rounded-[var(--radius-large)] transition-all hover:translate-y-[-2px]">
                        {/* 头像 */}
                        <div class="w-28 h-28 flex-shrink-0 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-900">
                            <img src={friend.icon} alt={`${friend.name}的头像`} class="w-full h-full object-cover" loading="lazy" />
                        </div>
                        
                        {/* 文字描述：增加 w-0 和 grow 防止文本撑破布局 */}
                        <div class="grow w-0 flex flex-col justify-center">
                            <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 mb-1 truncate">
                                {friend.name}
                            </div>
                            <div class="text-50 text-sm font-medium line-clamp-2">
                                {friend.description}
                            </div>
                        </div>

                        {/* 进入按钮 */}
                        <a href={friend.url} target="_blank" rel="noopener noreferrer" 
                           class="flex items-center justify-center btn-regular w-12 rounded-lg bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:scale-95 transition-all"
                           aria-label={`访问 ${friend.name}`}>
                            <svg xmlns="http://www.w3.org/2000/svg" class="text-[var(--primary)] text-3xl" width="1em" height="1em" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M12.6 12L8.7 8.1q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.6 4.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-4.6 4.6q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7z"></path>
                            </svg>
                        </a>
                    </div>
                ))}
            </div>
            
            <div class="mt-8 text-center">
                <p class="text-sm text-neutral-600 dark:text-neutral-400">The end Ciallo~ (∠・ω< )⌒☆</p>
            </div>
        </div>
    </div>

    {/* 底部：Giscus 评论区 */}
    {/* <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mt-4">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
            <Giscus />
        </div>
    </div> */}
</MainGridLayout>